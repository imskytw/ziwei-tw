# ════════════════════════════════════════════════════════════
#  紫微斗數（繁體版）設定檔範本
#  最簡單的方式：執行 npm run setup（或雙擊「設定AI」），用問答產生 .env.local
#  也可以手動：把這個檔案複製成 .env.local，再填入下面的值
#  ⚠️ .env.local 含有金鑰，不要上傳到 GitHub 或分享給別人
# ════════════════════════════════════════════════════════════

# ── 1. 選擇 AI（擇一）：openai | anthropic | gemini | deepseek | ollama | custom
#    也接受別名：chatgpt = openai、claude = anthropic
AI_PROVIDER=openai

# ── 2. 填入對應的金鑰（只要填你選的那一家）
OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# Ollama 本機模型不需要金鑰

# ── 3.（選填）換模型。不填就用預設：
#    openai → gpt-6.1-sol ｜ anthropic → claude-sonnet-5-5 ｜ gemini → gemini-3.8-flash
#    deepseek → deepseek-chat ｜ ollama → qwen3
# AI_MODEL=

# ── 4.（選填）自訂服務網址：選 custom 時必填；Ollama 不在本機時也可改這裡
# AI_BASE_URL=https://api.example.com/v1
# CUSTOM_API_KEY=

# ── 5.（選填）網站名稱與網址
# NEXT_PUBLIC_SITE_NAME=紫微命盤
# NEXT_PUBLIC_SITE_URL=http://localhost:3456
